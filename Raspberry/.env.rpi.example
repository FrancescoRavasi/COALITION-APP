# .env.rpi.example — Variabili d'ambiente per Coalition App su Raspberry Pi
# Copia questo file in .env e modifica i valori prima di avviare Docker Compose.
# NON committare .env con valori reali nel repository.

# ---------------------------------------------------------------------------
# Obbligatorio
# ---------------------------------------------------------------------------

# Chiave segreta Django — genera con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-questa-chiave-con-una-stringa-random-lunga

# IP o hostname del Raspberry Pi sulla LAN (separati da virgola)
ALLOWED_HOSTS=192.168.1.xxx,localhost,127.0.0.1

# URL di connessione al database PostgreSQL
# Formato: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Su Docker Compose il host è "db" (nome del servizio)
DATABASE_URL=postgresql://coalition:password@db:5432/coalition

# ---------------------------------------------------------------------------
# Discord OAuth (dal Discord Developer Portal → Applications → OAuth2)
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ID numerico del server (Guild) Discord
# Aprilo in Discord → tasto destro sul server → Copia ID server
GUILD_ID=

# ---------------------------------------------------------------------------
# Superuser Django iniziale (creato automaticamente al primo avvio)
# ---------------------------------------------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# ---------------------------------------------------------------------------
# Opzionale — lascia vuoto per disabilitare
# ---------------------------------------------------------------------------

# Token Logfire per osservabilità cloud (https://logfire.pydantic.dev/)
# Se vuoto, i log restano locali senza inviare nulla al cloud
LOGFIRE_TOKEN=

# ZwiftRacing App API (necessaria per zwiftracing features)
ZRAPP_API_KEY=
ZRAPP_API_URL=https://api.zwiftracing.app/api/public/

# AWS S3 (necessario solo se usi django-storages con S3 per i media)
# Lascia vuoto per usare il volume Docker locale
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
